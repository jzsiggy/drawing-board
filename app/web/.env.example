# Copy to .env.local and fill in. .env.local is gitignored; on Vercel, add the
# same names under Project -> Settings -> Environment Variables.
# Values: Supabase dashboard -> Project Settings -> API Keys.

NEXT_PUBLIC_SUPABASE_URL=https://ofmpqffpjgvolcppeemu.supabase.co
# "Publishable key" (sb_publishable_...), or the legacy anon key. Safe in browsers.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# "Secret key" (sb_secret_...), or the legacy service_role key. Server only:
# it bypasses row-level security.
SUPABASE_SECRET_KEY=

# Phase 3: Google AI Studio key for Nano Banana.
GEMINI_API_KEY=
